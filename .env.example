# ==============================================================================
# connectED Telegram Bot Service — Environment Configuration Template
# ==============================================================================

# Application & Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8080

# Official Telegram Bot API Configuration
# Obtain your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ_1234567
TELEGRAM_BOT_USERNAME=ConnectEdMentorBot
TELEGRAM_API_BASE_URL=https://api.telegram.org

# Telegram Webhook Configuration
# Must be a valid public HTTPS URL pointing to /api/v1/webhooks/telegram
TELEGRAM_WEBHOOK_URL=https://api.connected.iiit.ac.in/api/v1/webhooks/telegram

# Secret token sent by Telegram in 'X-Telegram-Bot-Api-Secret-Token' header
# Generate a high-entropy string (1-256 characters: A-Z, a-z, 0-9, _, -)
TELEGRAM_WEBHOOK_SECRET_TOKEN=connected_telegram_webhook_secret_key_prod_8989_xyz

# connectED Authoritative Backend (Person 2)
BACKEND_API_BASE_URL=http://localhost:8000/api/v1
# Shared Bearer token for authenticating internal backend-to-bot events
BACKEND_SERVICE_TOKEN=connected_backend_internal_service_secret_token_456

# Workflow & Security Lifecycles
# Validity window for single-use account linking tokens (in seconds, default 900 = 15 mins)
LINKING_TOKEN_TTL_SECONDS=900
# Response SLA for mentorship requests (in hours)
MENTORSHIP_TIMEOUT_HOURS=48
# TTL for deduplicating incoming Telegram update_ids and event_ids (in seconds, 86400 = 24 hours)
IDEMPOTENCY_TTL_SECONDS=86400

# Resilience & Retries
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=1.5
