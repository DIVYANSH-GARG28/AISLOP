    {
      "parameters": {
        "jsCode": "const payload = $input.first().json.body || $input.first().json;\n\nconst email = payload.email || 'student@its.edu.in';\nconst otp = payload.otp || '000000';\nconst instName = payload.institution_name || 'I.T.S Engineering College';\nconst expiresMins = payload.expires_in_minutes || 10;\n\nconst emailHtml = `\n<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 24px; border: 1px solid #e2e8f0; border-radius: 12px; background: #ffffff;\">\n  <div style=\"text-align: center; margin-bottom: 24px;\">\n    <h1 style=\"color: #4f46e5; margin: 0; font-size: 26px;\">connectED</h1>\n    <p style=\"color: #64748b; font-size: 14px; margin-top: 4px;\">${instName} — Institutional Access</p>\n  </div>\n  <div style=\"background: #f8fafc; border-radius: 8px; padding: 24px; text-align: center; margin-bottom: 20px; border: 1px solid #e0e7ff;\">\n    <p style=\"margin: 0 0 12px 0; color: #334155; font-size: 14px;\">Use the one-time verification code below to verify your official institutional account:</p>\n    <div style=\"font-size: 36px; font-weight: 800; letter-spacing: 8px; color: #1e1b4b; background: #e0e7ff; padding: 14px 28px; border-radius: 10px; display: inline-block; font-family: monospace;\">\n      ${otp}\n    </div>\n    <p style=\"margin: 14px 0 0 0; color: #dc2626; font-size: 12px; font-weight: bold;\">⏳ Valid for ${expiresMins} minutes only. Never share this code.</p>\n  </div>\n  <p style=\"color: #64748b; font-size: 12px; line-height: 1.6;\">\n    This verification unlocks exclusive campus placement drives, verified student batch directories, and institutional announcements.\n  </p>\n</div>`;\n\nreturn [{\n  json: {\n    ...payload,\n    email,\n    otp,\n    institution_name: instName,\n    email_subject: `🎓 connectED: Verification Code for ${instName} [${otp}]`,\n    email_html: emailHtml,\n    processed_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "node_code_format_otp_email",
      "name": "Code: Format Institute Verification Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        550,
        1100
      ]
    },
