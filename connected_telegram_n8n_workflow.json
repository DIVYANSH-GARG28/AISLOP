      "parameters": {
        "chatId": "={{ $json.telegram_chat_id }}",
        "text": "=🎓 <b>New Mentorship Request!</b>\n\n<b>Student:</b> {{ $('Webhook: Ingest Mentorship Request').item.json.body.mentee_name }}\n<b>Topic:</b> {{ $('Webhook: Ingest Mentorship Request').item.json.body.topic }}\n<b>Skills:</b> {{ $('Webhook: Ingest Mentorship Request').item.json.body.skills.join(' • ') }}\n\n💬 <b>Message:</b>\n<i>\"{{ $('Webhook: Ingest Mentorship Request').item.json.body.message }}\"</i>\n\n⏳ <b>Response Deadline:</b> 48 Hours\n<i>Request ID:</i> <code>{{ $('Webhook: Ingest Mentorship Request').item.json.body.request_id }}</code>\n\nWould you like to mentor this student?",
        "replyMarkup": "inlineKeyboard",
